#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

export VOLTA_HOME="${VOLTA_HOME:-$HOME/.volta}"
export PATH="$VOLTA_HOME/bin:$HOME/.local/bin:$PATH"

echo "Installing the pinned Node.js toolchain..."
if ! command -v volta >/dev/null 2>&1; then
  curl --fail --silent --show-error https://get.volta.sh | bash
fi
volta install node@24.1.0
mkdir -p "$HOME/.local/bin"
for command in node npm npx volta; do
  ln -sfn "$VOLTA_HOME/bin/$command" "$HOME/.local/bin/$command"
done

echo "Installing locked npm dependencies..."
npm ci

echo "Installing Playwright browsers and system dependencies..."
npx playwright install --with-deps

echo "Preparing the local environment and development database..."
if [[ ! -f .env ]]; then
  cp -- .env.example .env
elif ! grep -q '^DATABASE_URL=' .env; then
  printf '\nDATABASE_URL="file:./dev.db"\n' >>.env
fi
seed_database=false
if [[ ! -f prisma/dev.db ]]; then
  seed_database=true
fi
DATABASE_URL='file:./dev.db' npx prisma migrate deploy
if [[ "$seed_database" == true ]]; then
  DATABASE_URL='file:./dev.db' npx prisma db seed
fi

echo "Orb setup complete."
