{
  // Kelas Rumah Berbagi - Remix + React + TypeScript + Tailwind
  "tab_size": 2,
  "hard_tabs": false,
  "format_on_save": "on",
  "preferred_line_length": 120,

  "languages": {
    "TypeScript": {
      "tab_size": 2,
      "formatter": {
        "external": {
          "command": "npx",
          "arguments": ["prettier", "--stdin-filepath", "{buffer_path}"]
        }
      },
      "format_on_save": "on"
    },
    "TSX": {
      "tab_size": 2,
      "formatter": {
        "external": {
          "command": "npx",
          "arguments": ["prettier", "--stdin-filepath", "{buffer_path}"]
        }
      },
      "format_on_save": "on"
    },
    "JavaScript": {
      "tab_size": 2,
      "formatter": {
        "external": {
          "command": "npx",
          "arguments": ["prettier", "--stdin-filepath", "{buffer_path}"]
        }
      }
    },
    "CSS": {
      "tab_size": 2
    },
    "JSON": {
      "tab_size": 2
    },
    "YAML": {
      "tab_size": 2
    },
    "Prisma": {
      "format_on_save": "on",
      "formatter": "language_server"
    }
  },

  "lsp": {
    "typescript-language-server": {
      "initialization_options": {
        "preferences": {
          "includeInlayParameterNameHints": "literals",
          "includeInlayFunctionParameterTypeHints": true,
          "includeInlayVariableTypeHints": false,
          "includeInlayPropertyDeclarationTypeHints": true,
          "includeInlayFunctionLikeReturnTypeHints": true
        }
      }
    },
    "eslint": {
      "settings": {
        "validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"]
      }
    },
    "tailwindcss-language-server": {
      "settings": {
        "includeLanguages": {
          "typescriptreact": "html",
          "javascriptreact": "html"
        }
      }
    }
  },

  // Exclude from search (mirrors VS Code settings)
  "file_scan_exclusions": [
    ".cache/**",
    "node_modules/**",
    "build/**",
    "public/build/**",
    ".git/**"
  ]
}
